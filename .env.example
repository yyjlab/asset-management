# 复制为 .env 后再修改。不要把真实密码提交到 Git。
# 建议使用：openssl rand -base64 32
MYSQL_ROOT_PASSWORD=请替换为MySQL管理员强密码
MYSQL_PASSWORD=请替换为资产系统数据库强密码

# 首次启动自动创建的超级管理员。密码至少8位，请务必修改。
ASSET_ADMIN_USERNAME=admin
ASSET_ADMIN_PASSWORD=请替换为超级管理员登录强密码

# Web 容器绑定的宿主机地址和端口。
# 同机反向代理可使用 127.0.0.1；独立反向代理应填写业务服务器自己的内网 IP，
# 并在防火墙中只允许反向代理服务器访问该端口。不要填写远端 Nginx 服务器的 IP。
HTTP_BIND_IP=0.0.0.0
HTTP_PORT=80

# 可选的二维码访问地址初始值；也可以部署后由超级管理员在“设置”页面保存。
# 开源默认留空，禁止绑定作者域名。例如：https://asset.example.com
ASSET_PUBLIC_BASE_URL=

# Java 数据库连接池；小型内部系统默认值即可。
DB_POOL_SIZE=10
DB_POOL_MIN_IDLE=2

# 钉钉网页登录；密钥只在部署环境填写，不能提交到仓库。
DINGTALK_LOGIN_ENABLED=false
DINGTALK_LOGIN_CLIENT_ID=
DINGTALK_LOGIN_CLIENT_SECRET=
DINGTALK_LOGIN_REDIRECT_URI=http://asset.wfq.com/api/v1/auth/dingtalk/callback
DINGTALK_LOGIN_STATE_TTL_SECONDS=600
DINGTALK_LOGIN_TIMEOUT_SECONDS=10

# 钉钉 OA 实物交接（复用上述应用凭证）；联调前保持关闭。见 DINGTALK_OA.md。
DINGTALK_OA_ENABLED=false
DINGTALK_OA_STREAM_ENABLED=true
DINGTALK_OA_CORP_ID=
DINGTALK_OA_ISSUE_PROCESS_CODE=
DINGTALK_OA_RETURN_PROCESS_CODE=
DINGTALK_OA_IT_APPROVER_USER_IDS=
DINGTALK_OA_AGENT_ID=0

# 业务工作流钉钉群提醒（不是WUD更新通知）；默认关闭。需使用启用加签的群机器人。
ASSET_WORKFLOW_NOTIFY_ENABLED=false
ASSET_WORKFLOW_DINGTALK_WEBHOOK=
ASSET_WORKFLOW_DINGTALK_SECRET=
